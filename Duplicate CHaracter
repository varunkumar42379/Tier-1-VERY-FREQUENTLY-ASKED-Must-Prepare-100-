import java.util.*;
class Main {
    public static void main(String[] args) {
         String str="automation";

         Set<Character> set=new HashSet<>();

         Set<Character> duplicates=new HashSet<>();

        for(char ch:str.toCharArray()){
            if(set.contains(ch)){
            duplicates.add(ch);
        }else{
            set.add(ch);
        }
    }
    
        System.out.print(duplicates);
    }
}
