import java.util.*;
class Main {
    public static void main(String[] args) {
         String str="automation";

         int vowels=0;
         int consonents=0;

        for(char ch:str.toCharArray()){
            if("AEIOUaeiou".indexOf(ch)!=-1){
                vowels++;
            }
            else if(Character.isLetter(ch)){
                consonents++;
            }
        }
        System.out.print("vowels:"+vowels+"  consonents:"+consonents);
    }
}
